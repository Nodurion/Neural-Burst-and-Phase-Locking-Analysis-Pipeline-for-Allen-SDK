def filter_freq_band(signal, FS, band):
nyquist = 0.5 * FS
low, high = band[0] / nyquist, band[1] / nyquist
b, a = butter(2, [low, high], btype='band')
return filtfilt(b, a, signal)
def calculate_mvl(angles_all_trials):
if len(angles_all_trials) < 10:
return np.nan
mean_vector_length = np.abs(np.nanmean(np.exp(1j *
np.array(angles_all_trials))))
if mean_vector_length == 1.0:
return np.nan
NT = np.sum(~np.isnan(angles_all_trials))
MLVsquare = mean_vector_length ** 2
MLV_unbiased = (1 / (NT - 1)) * ((MLVsquare * NT) - 1)
return MLV_unbiased
def process_events(events_per_unit, Vm_segments, band_label):
print(f"Processing spikes for {band_label} band")
plv = {}
units_with_events = []
angles_all_units = []
for unit in events_per_unit:
event_times_unit = events_per_unit[unit]
if event_times_unit.size == 0 or np.all(event_times_unit == 0):
continue
angles_all_trials = []
has_events = False
event_indices_count = 0
for trial_index, event_times in enumerate(event_times_unit):
event_indices = np.where(event_times == 1)[0]
if len(event_indices) == 0:
continue
Vm = Vm_segments[trial_index]
angles_vm = np.angle(hilbert(Vm))
angles_events = angles_vm[event_indices]
if len(angles_events) == 0:
continue
angles_all_trials.extend(angles_events)
has_events = True
event_indices_count += len(event_indices)
